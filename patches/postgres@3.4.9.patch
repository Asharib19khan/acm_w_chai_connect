diff --git a/cf/src/connection.js b/cf/src/connection.js
index 8e79170aeb13efe8c3c77ccede0cd3a115b5e1b5..94b15aa869b9603a43176e29bf5c5188651d88c1 100644
--- a/cf/src/connection.js
+++ b/cf/src/connection.js
@@ -237,7 +237,10 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
     q.onlyDescribe && (delete statements[q.signature])
     q.parameters = q.parameters || parameters
     q.prepared = q.prepare && q.signature in statements
-    q.describeFirst = q.onlyDescribe || (parameters.length && !q.prepared)
+    // chai-connect patch: describe first even with no parameters. Supabase's transaction pooler
+    // (Supavisor) hangs on the one-shot Parse+Bind path once a connection is reused.
+    // (BEGIN keeps the one-shot path: its onexecute hook hands the transaction its connection.)
+    q.describeFirst = q.onlyDescribe || (!q.prepared && !q.options.onexecute)
     q.statement = q.prepared
       ? statements[q.signature]
       : { string, types, name: q.prepare ? statementId + statementCount++ : '' }
