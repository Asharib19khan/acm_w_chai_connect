# Copy to each app's .env.local (apps/web, apps/moments, apps/desk, apps/control). Never commit those.
# Locally every variable is optional; Vercel production/preview deploys require the ones each app
# lists in its src/env.ts. Each app is its own Vercel project with its own NEXT_PUBLIC_SITE_URL.
# Generate random keys with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# --- every app ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TURNSTILE_SECRET_KEY=
IP_HASH_KEY=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- apps/web (student site) and apps/moments (photo uploads) ---
DEVICE_TOKEN_KEY=
TOKEN_ENCRYPTION_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
RELAY_TICKET_KEY=
NEXT_PUBLIC_RELAY_URL=

# --- apps/control (display + admin) and apps/desk (games desk): same keys, so sign-in works on both ---
TOTP_ENCRYPTION_KEY=
SESSION_HMAC_KEY=

# --- apps/desk only: key asked for before "Allow another try" (never commit the real one) ---
RETRY_SECRET=

# --- apps/control only ---
CRON_SECRET=
SUPERADMIN_EMAIL=
NEXT_PUBLIC_STUDENT_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Share the moment (apps/moments). Run `pnpm drive:connect` to fill these in apps/moments/.env.local.
GOOGLE_DRIVE_REFRESH_TOKEN=
MOMENTS_TICKET_KEY=
# Drive folder IDs (the part after /folders/ in each link).
MOMENTS_FOLDER_ROOT=
MOMENTS_FOLDER_PHOTOS=
MOMENTS_FOLDER_VIDEOS=
# "false" closes uploads.
MOMENTS_OPEN=
