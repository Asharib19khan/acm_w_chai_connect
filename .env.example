# Copy to apps/web/.env.local and apps/control/.env.local (never commit those).
# Locally every variable is optional; Vercel production/preview deploys require all of them.
# Generate random keys with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# --- both apps ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TURNSTILE_SECRET_KEY=
IP_HASH_KEY=
TOKEN_ENCRYPTION_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- apps/web only ---
DEVICE_TOKEN_KEY=
RELAY_TICKET_KEY=
NEXT_PUBLIC_RELAY_URL=

# --- apps/control only ---
TOTP_ENCRYPTION_KEY=
SESSION_HMAC_KEY=
CRON_SECRET=
SUPERADMIN_EMAIL=
NEXT_PUBLIC_STUDENT_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
