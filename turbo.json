{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalEnv": [
    "NODE_ENV",
    "VERCEL_ENV",
    "CI"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ],
      "env": [
        "NEXT_PUBLIC_*",
        "SUPABASE_*",
        "UPSTASH_*",
        "TURNSTILE_*",
        "GOOGLE_*",
        "SENTRY_*",
        "*_KEY",
        "CRON_SECRET",
        "SUPERADMIN_EMAIL",
        "MOMENTS_*",
        "RETRY_SECRET",
        "DATABASE_URL",
        "CV_FOLDER_ID",
        "QUIZ_SWEEP_MS"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    }
  }
}
